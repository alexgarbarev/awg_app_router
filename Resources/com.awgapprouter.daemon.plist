<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.awgapprouter.daemon</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/lib/awgapprouter/awgapprouterd</string>
    </array>
    <key>MachServices</key>
    <dict>
        <key>com.awgapprouter.daemon</key>
        <true/>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>2</integer>
    <key>StandardOutPath</key>
    <string>/var/log/awgapprouter-daemon.log</string>
    <key>StandardErrorPath</key>
    <string>/var/log/awgapprouter-daemon.log</string>
</dict>
</plist>
